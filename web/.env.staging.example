# ==============================================================================
# KANVTECH SERVICE MANAGEMENT — WEB STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env.staging` or set in staging container environment variables.
# ==============================================================================

# Public API URL for browser clients (defaults to '/api' for same-domain reverse proxy routing)
NEXT_PUBLIC_API_URL=/api

# Upstream Backend Internal Service URL (used by Next.js rewrites)
# In Docker Compose or Kubernetes: http://staging-backend:5000
BACKEND_INTERNAL_URL="http://127.0.0.1:5000"

# Gating for 1-Click Evaluation Credentials on Login Page (strictly false for staging/production)
NEXT_PUBLIC_ENABLE_DEMO_LOGINS=false
