# ==============================================================================
# KANVTECH SERVICE MANAGEMENT — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env.staging` or set in staging container/host secrets.
# NEVER commit real production or staging secrets to version control.
# ==============================================================================

# Node Runtime Environment
NODE_ENV=staging
PORT=5000

# PostgreSQL Staging Connection (SSL mode recommended for remote hosts)
# Example: postgresql://kanvtech_staging_user:PASSWORD@staging-db.internal:5432/kanvtech_sm_staging?schema=public&sslmode=require
DATABASE_URL="postgresql://<staging_db_user>:<staging_db_password>@<staging_db_host>:5432/kanvtech_sm_staging?schema=public"

# Cryptographic JSON Web Token Configuration
# Generate a cryptographically secure 256-bit key: openssl rand -base64 32
JWT_SECRET="<generate-strong-random-jwt-secret-minimum-32-chars>"
JWT_EXPIRES_IN="24h"

# CORS Allowed Web Origins (Strictly restrict to staging web URL)
# Example: https://staging.kanvtech.com,http://staging-web:3000
CORS_ORIGIN="https://staging.kanvtech.com"

# API Documentation / Swagger (Enabled for staging QA testing, disabled in production)
SWAGGER_ENABLED=true

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=s3
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="kanvtech-staging-attachments"
S3_ACCESS_KEY="<staging_s3_access_key>"
S3_SECRET_KEY="<staging_s3_secret_key>"

# Max Attachment Upload Size in MB
MAX_ATTACHMENT_SIZE_MB=10

# Optional Redis BullMQ Worker (Only required if running multi-instance backend containers)
# REDIS_HOST="staging-redis.internal"
# REDIS_PORT=6379
