{
  "name": "kanvtech-backend",
  "version": "2.0.0",
  "description": "Kanvtech Service Management Platform - Modular Monolith NestJS Backend",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && ts-node prisma/seed.ts && node dist/src/main",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:prod": "ts-node prisma/seed.prod.ts",
    "admin:create": "ts-node scripts/create-admin.ts",
    "test": "ts-node test/runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.654.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.20.0",
    "@types/node": "^22.5.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0"
  }
}
