# Kanvtech Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with actual configuration

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kanvtech

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_string

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# API Documentation
SWAGGER_ENABLED=true
